From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@localhost>
Date: Fri, 22 May 2026 00:00:00 +0200
Subject: [PATCH] Ignore FabricEscrowVault errors in KmxServiceReceiver

---
 .../kmxservice/common/receiver/KmxServiceReceiver.smali       | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/smali_classes2/com/samsung/android/kmxservice/common/receiver/KmxServiceReceiver.smali b/smali_classes2/com/samsung/android/kmxservice/common/receiver/KmxServiceReceiver.smali
index 111111111..222222222 100644
--- a/smali_classes2/com/samsung/android/kmxservice/common/receiver/KmxServiceReceiver.smali
+++ b/smali_classes2/com/samsung/android/kmxservice/common/receiver/KmxServiceReceiver.smali
@@ -261,6 +261,7 @@
     if-eqz v1, :cond_0
 
     :cond_1
+    :try_start_0
     invoke-static {}, Lcom/samsung/security/fabric/crypto/FabricEscrowVault;->getInstance()Lcom/samsung/security/fabric/crypto/FabricEscrowVault;
 
     move-result-object p0
@@ -269,6 +270,8 @@
 
     move-result p0
 
+    :try_end_0
+.catch Ljava/lang/RuntimeException; {:try_start_0 .. :try_end_0} :catch_0
     if-eqz p0, :cond_2
 
     const-string p0, "persist.escrowvault.sa.signed"
@@ -277,6 +280,17 @@
 
     invoke-static {p0, v0}, Landroid/os/SemSystemProperties;->set(Ljava/lang/String;Ljava/lang/String;)V
 
+    goto :cond_2
+
+    :catch_0
+    move-exception p0
+
+    const-string v1, "Ignoring FabricEscrowVault evIsExistKey failure"
+
+    invoke-static {v0, v1, p0}, Landroid/util/Log;->w(Ljava/lang/String;Ljava/lang/String;Ljava/lang/Throwable;)I
+
+    move-result p0
+
     :cond_2
     invoke-static {p1}, Lcom/google/crypto/tink/shaded/protobuf/E;->m(Landroid/content/Context;)Landroid/content/SharedPreferences;
 
-- 
2.51.1
