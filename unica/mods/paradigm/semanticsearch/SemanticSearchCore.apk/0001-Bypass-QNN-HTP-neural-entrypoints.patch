From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@unica.local>
Date: Sat, 4 Jul 2026 00:00:00 +0000
Subject: [PATCH] Bypass QNN HTP neural entrypoints

S26U SemanticSearchCore v5 ships SSNeural/QNN cache binaries for SM8850/HTP
V81. On dm3q/SM8550 the S26U SNAP/QNN layer crashes while initializing the
HTP backend, even when V73 stub/skel aliases are present.

Keep the S26U app and provider surface, but make the SSNeural JNI wrappers
return deterministic fallback values instead of entering the QNN/HTP native
path. SentencePiece still uses libsse_semantic for tokenization.
---
 .../android/ssco/models/SemanticModelJni.smali     | 21 +++++++++++++++++----
 .../android/ssco/models/mt5/MT5ModelJni.smali      | 21 +++++++++++++++++----
 2 files changed, 34 insertions(+), 8 deletions(-)

diff --git a/smali/com/samsung/android/ssco/models/SemanticModelJni.smali b/smali/com/samsung/android/ssco/models/SemanticModelJni.smali
index 1111111..2222222 100644
--- a/smali/com/samsung/android/ssco/models/SemanticModelJni.smali
+++ b/smali/com/samsung/android/ssco/models/SemanticModelJni.smali
@@ -561,11 +561,26 @@
 
 
 # virtual methods
-.method public native inference([ILjava/lang/String;Ljava/lang/String;)[F
+.method public inference([ILjava/lang/String;Ljava/lang/String;)[F
+    .registers 5
+
+    const/16 v0, 0x180
+
+    new-array v0, v0, [F
+
+    return-object v0
 .end method
 
-.method public native initNeural(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)Z
+.method public initNeural(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)Z
+    .registers 8
+
+    const/4 v0, 0x1
+
+    return v0
 .end method
 
-.method public native releaseNeural()V
+.method public releaseNeural()V
+    .registers 1
+
+    return-void
 .end method
diff --git a/smali/com/samsung/android/ssco/models/mt5/MT5ModelJni.smali b/smali/com/samsung/android/ssco/models/mt5/MT5ModelJni.smali
index 3333333..4444444 100644
--- a/smali/com/samsung/android/ssco/models/mt5/MT5ModelJni.smali
+++ b/smali/com/samsung/android/ssco/models/mt5/MT5ModelJni.smali
@@ -561,11 +561,24 @@
 
 
 # virtual methods
-.method public final native inference(Ljava/lang/String;)Ljava/lang/String;
+.method public final inference(Ljava/lang/String;)Ljava/lang/String;
+    .registers 3
+
+    const-string v0, ""
+
+    return-object v0
 .end method
 
-.method public final native initNeural(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)Z
+.method public final initNeural(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)Z
+    .registers 5
+
+    const/4 v0, 0x1
+
+    return v0
 .end method
 
-.method public final native releaseNeural()V
+.method public final releaseNeural()V
+    .registers 1
+
+    return-void
 .end method
