From 8e0daa9e2041774a1cb814022f54a04441ae5b24 Mon Sep 17 00:00:00 2001
From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Date: Tue, 9 Sep 2025 00:06:16 +0200
Subject: [PATCH] Add Adaptive color tone feature

---
 .../settings/SecUpgradeController.smali | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/smali/com/android/providers/settings/SecUpgradeController.smali b/smali/com/android/providers/settings/SecUpgradeController.smali
--- a/smali/com/android/providers/settings/SecUpgradeController.smali
+++ b/smali/com/android/providers/settings/SecUpgradeController.smali
@@ -8909,12 +8909,39 @@
     goto :goto_8
 
     :cond_19
     move-object/from16 v10, v26
 
     :goto_8
+    const-string/jumbo v1, "ead_enabled"
+
+    invoke-virtual {v2, v1}, Lcom/android/providers/settings/SettingsState;->getSettingLocked(Ljava/lang/String;)Lcom/android/providers/settings/SettingsState$Setting;
+
+    move-result-object v1
+
+    invoke-virtual {v1}, Lcom/android/providers/settings/SettingsState$Setting;->isNull()Z
+
+    move-result v1
+
+    if-eqz v1, :cond_ead_initialized
+
+    const/4 v8, 0x1
+
+    const-string v9, "android"
+
+    const-string/jumbo v5, "ead_enabled"
+
+    const-string v6, "0"
+
+    const/4 v7, 0x0
+
+    move-object v4, v2
+
+    invoke-virtual/range {v4 .. v9}, Lcom/android/providers/settings/SettingsState;->insertSettingOverrideableByRestoreLocked(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;ZLjava/lang/String;)Z
+
+    :cond_ead_initialized
     invoke-static {}, Lcom/samsung/android/feature/SemFloatingFeature;->getInstance()Lcom/samsung/android/feature/SemFloatingFeature;
 
     move-result-object v1
 
     const-string v4, "SEC_FLOATING_FEATURE_LCD_CONFIG_VIVIDNESS"
 
-- 
