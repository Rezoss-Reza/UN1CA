From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@unica.local>
Date: Fri, 3 Jul 2026 00:00:00 +0000
Subject: [PATCH] Request Audio Eraser provider permission

SoundAlive_C protects AudioEraserProvider with
com.samsung.permission.ACCESS_AUDIO_ERASER_PROVIDER. SystemUI sends
package-aware AUDIO_ERASER_EFFECT commands to that provider, so request the
provider permission to avoid insert() failing with SecurityException before
SoundAlive can apply g_voice_booster_preset_all.
---
 AndroidManifest.xml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 1111111..2222222 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -30,6 +30,7 @@
     <permission android:name="com.samsung.systemui.POPUP_UI_PERMISSION" android:protectionLevel="signatureOrSystem"/>
     <uses-permission android:name="com.samsung.systemui.POPUP_UI_PERMISSION"/>
     <uses-permission android:name="com.samsung.android.permission.MULTI_WINDOW_MONITOR"/>
+    <uses-permission android:name="com.samsung.permission.ACCESS_AUDIO_ERASER_PROVIDER"/>
     <uses-permission android:name="com.samsung.android.app.parentalcare.permission.READ_CARE"/>
     <uses-permission android:name="com.samsung.android.app.parentalcare.permission.CONTROL_CARE"/>
     <uses-permission android:name="android.permission.MANAGE_CONTENT_SUGGESTIONS"/>
-- 
2.43.0
