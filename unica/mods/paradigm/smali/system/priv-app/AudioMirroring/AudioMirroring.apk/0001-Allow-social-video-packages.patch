 .../service/MediaRoute2MirroringProviderService.smali          |  2 ++
 smali/k1/b.smali                                               | 53 +++++++++++++++++
 2 files changed, 55 insertions(+)

diff --git a/smali/com/samsung/android/audiomirroring/service/MediaRoute2MirroringProviderService.smali b/smali/com/samsung/android/audiomirroring/service/MediaRoute2MirroringProviderService.smali
index 1111111..2222222 100644
--- a/smali/com/samsung/android/audiomirroring/service/MediaRoute2MirroringProviderService.smali
+++ b/smali/com/samsung/android/audiomirroring/service/MediaRoute2MirroringProviderService.smali
@@ -2445,6 +2445,8 @@

     iput-object v1, p0, Lcom/samsung/android/audiomirroring/service/MediaRoute2MirroringProviderService;->g:Landroid/content/Context;

+    sput-object v1, Lk1/b;->h:Landroid/content/Context;
+
     invoke-static {}, LW/a;->m()Ljava/lang/String;

     move-result-object v1
diff --git a/smali/k1/b.smali b/smali/k1/b.smali
