From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@unica.local>
Date: Fri, 3 Jul 2026 00:00:00 +0000
Subject: [PATCH] Allow SystemUI Audio Eraser provider access

SystemUI controls Audio Eraser from the quick panel, but SoundAlive_C protects
AudioEraserProvider with com.samsung.permission.ACCESS_AUDIO_ERASER_PROVIDER.
On this port, SystemUI is denied before SoundAlive can process
AUDIO_ERASER_EFFECT.

Restrict the provider to android.permission.STATUS_BAR instead. SystemUI
already holds this signature permission, and the provider is still not exposed
to normal third-party apps.
---
 AndroidManifest.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 1111111..2222222 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -111,7 +111,7 @@
             <meta-data android:name="com.android.settings.order" android:value="302500"/>
         </activity>
         <provider android:authorities="com.sec.android.app.soundalive.compatibility.SAContentProvider" android:exported="true" android:name="com.sec.android.app.soundalive.compatibility.SAContentProvider"/>
-        <provider android:authorities="com.sec.android.app.soundalive.compatibility.AudioEraserProvider" android:exported="true" android:name="com.sec.android.app.soundalive.compatibility.AudioEraserProvider" android:permission="com.samsung.permission.ACCESS_AUDIO_ERASER_PROVIDER"/>
+        <provider android:authorities="com.sec.android.app.soundalive.compatibility.AudioEraserProvider" android:exported="true" android:name="com.sec.android.app.soundalive.compatibility.AudioEraserProvider" android:permission="android.permission.STATUS_BAR"/>
         <provider android:authorities="com.sec.android.app.soundalive.search" android:exported="true" android:grantUriPermissions="true" android:multiprocess="true" android:name="com.sec.android.app.soundalive.compatibility.SettingsSearchProvider" android:permission="android.permission.READ_SEARCH_INDEXABLES" android:process=":settingui">
             <intent-filter>
                 <action android:name="android.content.action.SEARCH_INDEXABLES_PROVIDER"/>
-- 
