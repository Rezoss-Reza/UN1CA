From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rezoss <rezoss79@users.noreply.github.com>
Date: Fri, 17 Jul 2026 00:15:00 +0200
Subject: [PATCH] Fix Notification Summary settings action

The S26U SmartSuggestions category spec launches a non-existent
BriefNotificationSummarySettingsActivity for Notification Summary. Redirect the
category click to the declared BriefContentsSubSettingsActivity and pass the
summary_notification parent key so the normal category settings UI is used.

---
diff --git a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/category/spec/categories/b.smali b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/category/spec/categories/b.smali
--- a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/category/spec/categories/b.smali
+++ b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/category/spec/categories/b.smali
@@ -136,12 +136,20 @@
 
     new-instance v0, Lzu/j;
 
-    const-string v1, "com.samsung.android.smartsuggestions.feature.aisuggestion.briefsettings.notification.BriefNotificationSummarySettingsActivity"
+    const-string v1, "com.samsung.android.smartsuggestions.feature.aisuggestion.briefsettings.contents.BriefContentsSubSettingsActivity"
 
     invoke-static {v7, v1, v8, v6, v8}, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/category/spec/categories/CategoryPlatformActionsKt;->explicitActivityIntent$default(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;ILjava/lang/Object;)Landroid/content/Intent;
 
     move-result-object v1
 
+    const-string v2, "parent_key"
+
+    const-string v3, "summary_notification"
+
+    invoke-virtual {v1, v2, v3}, Landroid/content/Intent;->putExtra(Ljava/lang/String;Ljava/lang/String;)Landroid/content/Intent;
+
+    move-result-object v1
+
     invoke-direct {v0, v1}, Lzu/j;-><init>(Landroid/content/Intent;)V
 
     invoke-static {v0}, Lkotlin/collections/u;->listOf(Ljava/lang/Object;)Ljava/util/List;
