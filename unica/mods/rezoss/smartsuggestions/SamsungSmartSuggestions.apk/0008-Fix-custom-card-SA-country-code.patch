From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rezoss <rezoss79@users.noreply.github.com>
Date: Fri, 17 Jul 2026 00:00:00 +0200
Subject: [PATCH] Fix Custom Card Samsung Account country code

Do not treat Samsung Account auth as ready when the app region/country code is
missing. If Samsung Account returns an empty cc value, recover it from the
cached BuiltInSource value, then from the locale ISO3 country initialized in
SAVariables, and finally default to FRA so the SIS country header is never
empty.

---
diff --git a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/source/CustomCardScsSuggestionClient.smali b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/source/CustomCardScsSuggestionClient.smali
--- a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/source/CustomCardScsSuggestionClient.smali
+++ b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/source/CustomCardScsSuggestionClient.smali
@@ -849,6 +849,16 @@
 
     if-nez p0, :cond_1
 
+    sget-object p0, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/d;->g:Ljava/lang/String;
+
+    if-eqz p0, :cond_1
+
+    invoke-static {p0}, Lkotlin/text/v;->isBlank(Ljava/lang/CharSequence;)Z
+
+    move-result p0
+
+    if-nez p0, :cond_1
+
     const/4 p0, 0x1
 
     return p0
diff --git a/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager$SACallback.smali b/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager$SACallback.smali
--- a/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager$SACallback.smali
+++ b/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager$SACallback.smali
@@ -203,6 +203,62 @@
 
     move-result-object p2
 
+    sget-object p3, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/d;->g:Ljava/lang/String;
+
+    if-eqz p3, :cond_rezoss_cc_cache
+
+    invoke-virtual {p3}, Ljava/lang/String;->length()I
+
+    move-result p3
+
+    if-lez p3, :cond_rezoss_cc_cache
+
+    goto :goto_rezoss_cc_ready
+
+    :cond_rezoss_cc_cache
+    invoke-static {p2}, Lkotlin/jvm/internal/h;->n(Ljava/lang/Object;)V
+
+    const-string/jumbo p3, "sa_cc"
+
+    const-string v2, ""
+
+    invoke-interface {p2, p3, v2}, Landroid/content/SharedPreferences;->getString(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;
+
+    move-result-object p3
+
+    if-eqz p3, :cond_rezoss_cc_locale
+
+    invoke-virtual {p3}, Ljava/lang/String;->length()I
+
+    move-result v2
+
+    if-lez v2, :cond_rezoss_cc_locale
+
+    sput-object p3, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/d;->g:Ljava/lang/String;
+
+    goto :goto_rezoss_cc_ready
+
+    :cond_rezoss_cc_locale
+    sget-object p3, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/d;->f:Ljava/lang/String;
+
+    if-eqz p3, :cond_rezoss_cc_default
+
+    invoke-virtual {p3}, Ljava/lang/String;->length()I
+
+    move-result v2
+
+    if-lez v2, :cond_rezoss_cc_default
+
+    sput-object p3, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/d;->g:Ljava/lang/String;
+
+    goto :goto_rezoss_cc_ready
+
+    :cond_rezoss_cc_default
+    const-string p3, "FRA"
+
+    sput-object p3, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/d;->g:Ljava/lang/String;
+
+    :goto_rezoss_cc_ready
     sget-object p3, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/d;->g:Ljava/lang/String;
 
     const-string v1, "appRegion"
