From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rezoss <rezoss79@users.noreply.github.com>
Date: Mon, 13 Jul 2026 00:00:00 +0200
Subject: [PATCH] Prefer context Now Bar cards

Lower Custom Card's generic Now Bar policy rank so it no longer dominates
calendar, commute, and weather cards during testing. Widen the calendar
eligibility window from 15 minutes to 180 minutes before an event, and raise
weather card rank enough to surface when no hero schedule/commute card is
eligible.

---
diff --git a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/core/ranker/WidgetNowBarSelector.smali b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/core/ranker/WidgetNowBarSelector.smali
--- a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/core/ranker/WidgetNowBarSelector.smali
+++ b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/core/ranker/WidgetNowBarSelector.smali
@@ -2566,7 +2566,7 @@
 
     sget-object p4, Ljava/util/concurrent/TimeUnit;->MINUTES:Ljava/util/concurrent/TimeUnit;
 
-    const-wide/16 v4, 0xf
+    const-wide/16 v4, 0xb4
 
     invoke-virtual {p4, v4, v5}, Ljava/util/concurrent/TimeUnit;->toMillis(J)J
 
diff --git a/smali_classes14/pv/c.smali b/smali_classes14/pv/c.smali
--- a/smali_classes14/pv/c.smali
+++ b/smali_classes14/pv/c.smali
@@ -141,7 +141,7 @@
 
     const-string v2, "Custom"
 
-    const/high16 v3, 0x41980000    # 19.0f
+    const/high16 v3, 0x40800000    # 4.0f
 
     const-string v5, "CustomCard"
 
@@ -155,7 +155,7 @@
 
     new-instance v0, Lpv/b;
 
-    const/high16 v2, 0x41980000    # 19.0f
+    const/high16 v2, 0x40800000    # 4.0f
 
     const-string v3, "CustomCardChn"
 
@@ -1503,7 +1503,7 @@
 
     const-string v11, "NB_58"
 
-    const/high16 v12, 0x3f800000    # 1.0f
+    const/high16 v12, 0x41800000    # 16.0f
 
     invoke-direct {v0, v11, v12, v4, v7}, Lpv/b;-><init>(Ljava/lang/String;FLjava/lang/String;Lcom/samsung/android/smartsuggestions/feature/aisuggestion/core/ranker/data/WidgetNowBarSelectorPolicy$WidgetNowBarDataCategory;)V
 
@@ -1557,7 +1557,7 @@
 
     move-object/from16 v21, v2
 
-    const/high16 v2, 0x3f800000    # 1.0f
+    const/high16 v2, 0x41800000    # 16.0f
 
     invoke-direct {v0, v11, v2, v12, v1}, Lpv/b;-><init>(Ljava/lang/String;FLjava/lang/String;Lcom/samsung/android/smartsuggestions/feature/aisuggestion/core/ranker/data/WidgetNowBarSelectorPolicy$WidgetNowBarDataCategory;)V
 
