From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rezoss <rezoss79@users.noreply.github.com>
Date: Fri, 3 Jul 2026 00:00:00 +0200
Subject: [PATCH] Relax Custom Card runtime policy

Remove the saved-card max-count block and use an existing Samsung Account
token before proactive refresh. Daily policy and AUTH_SA_ERROR recovery remain.

---
diff --git a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/repository/CustomCardRepositoryImpl.smali b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/repository/CustomCardRepositoryImpl.smali
--- a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/repository/CustomCardRepositoryImpl.smali
+++ b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/repository/CustomCardRepositoryImpl.smali
@@ -3599,7 +3599,7 @@
 
     move-result v0
 
-    if-le v0, p0, :cond_2
+    if-le v0, p0, :goto_0
 
     :goto_0
     const/4 p0, 0x1

diff --git a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/source/CustomCardScsSuggestionClient.smali b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/source/CustomCardScsSuggestionClient.smali
--- a/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/source/CustomCardScsSuggestionClient.smali
+++ b/smali_classes14/com/samsung/android/smartsuggestions/feature/aisuggestion/aiagent/data/source/CustomCardScsSuggestionClient.smali
@@ -700,7 +700,7 @@
 
     move-result p2
 
-    if-nez p2, :cond_3
+    if-nez p2, :goto_2
 
     sget-object p0, Ljava/lang/Boolean;->TRUE:Ljava/lang/Boolean;
 
diff --git a/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager.smali b/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager.smali
--- a/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager.smali
+++ b/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager.smali
@@ -1999,6 +1999,13 @@
 
     invoke-static {p0, p1}, Liz/b;->w(Lcom/samsung/android/smartsuggestions/feature/aisuggestion/ui/log/b;Ljava/lang/String;)V
 
+    if-eqz p1, :cond_rezoss_inflight_return
+
+    invoke-direct {p0}, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager;->stopSAService()V
+
+    invoke-direct {p0}, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager;->startServiceAndUpdateToken()V
+
+    :cond_rezoss_inflight_return
     return-void
 
     :cond_1
diff --git a/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/b.smali b/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/b.smali
--- a/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/b.smali
+++ b/smali_classes15/com/samsung/android/smartsuggestions/feature/aisuggestion/sa/b.smali
@@ -132,6 +132,8 @@
 
     invoke-static {p0, p1}, Liz/b;->l(Lcom/samsung/android/smartsuggestions/feature/aisuggestion/ui/log/b;Ljava/lang/String;)V
 
+    invoke-static {p0}, Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager;->access$stopSAService(Lcom/samsung/android/smartsuggestions/feature/aisuggestion/sa/SAServiceManager;)V
+
     return-void
 .end method
 
