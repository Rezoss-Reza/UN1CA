on post-fs-data
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/etc/unica/offlinelm_apk_hook.sh restore

on property:sys.boot_completed=1
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/etc/unica/offlinelm_apk_hook.sh apply

on property:persist.sys.unica.offlinelm_patch=1
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/etc/unica/offlinelm_apk_hook.sh apply
    setprop persist.sys.unica.offlinelm_patch 0

on property:persist.sys.unica.offlinelm_restore=1
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/etc/unica/offlinelm_apk_hook.sh restore
    setprop persist.sys.unica.offlinelm_restore 0
