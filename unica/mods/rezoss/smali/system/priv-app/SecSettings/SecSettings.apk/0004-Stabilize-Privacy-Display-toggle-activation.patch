From 9f731f7f991c4b6f38d31bde8c4b9248c8aa0004 Mon Sep 17 00:00:00 2001
From: Rezoss <rezoss@local>
Date: Thu, 2 Jul 2026 00:00:00 +0200
Subject: [PATCH] Stabilize Privacy Display toggle activation

diff --git a/res/xml/sec_pd_main_settings.xml b/res/xml/sec_pd_main_settings.xml
index 7d75a1b..a4f9e6c 100644
--- a/res/xml/sec_pd_main_settings.xml
+++ b/res/xml/sec_pd_main_settings.xml
@@ -1,6 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <PreferenceScreen android:title="@string/rezoss_pd_main_title"
   xmlns:android="http://schemas.android.com/apk/res/android">
-    <SecSwitchPreference android:title="@string/rezoss_pd_turn_on_title" android:key="pd_activation" android:summary="@string/rezoss_pd_fixed_description" />
-    <SecSwitchPreference android:title="@string/rezoss_pd_extra_dim_title" android:key="pd_extra_dim" android:summary="@string/rezoss_pd_extra_dim_summary" />
+    <SecSwitchPreference android:title="@string/rezoss_pd_turn_on_title" android:key="pd_activation" android:summary="@string/rezoss_pd_fixed_description" android:persistent="false" />
+    <SecSwitchPreference android:title="@string/rezoss_pd_extra_dim_title" android:key="pd_extra_dim" android:summary="@string/rezoss_pd_extra_dim_summary" android:persistent="false" />
 </PreferenceScreen>
diff --git a/smali_classes5/com/samsung/android/settings/bpd/PdMainSettings.smali b/smali_classes5/com/samsung/android/settings/bpd/PdMainSettings.smali
index a77f2fd..c9b3402 100644
--- a/smali_classes5/com/samsung/android/settings/bpd/PdMainSettings.smali
+++ b/smali_classes5/com/samsung/android/settings/bpd/PdMainSettings.smali
@@ -117,7 +117,7 @@
 .end method
 
 .method public final onPreferenceTreeClick(Landroidx/preference/Preference;)Z
-    .locals 3
+    .locals 5
 
     invoke-virtual {p1}, Landroidx/preference/Preference;->getKey()Ljava/lang/String;
 
@@ -137,11 +137,31 @@
 
     invoke-virtual {p1}, Landroidx/preference/TwoStatePreference;->isChecked()Z
 
-    move-result p0
+    move-result v3
+
+    invoke-virtual {p0}, Landroidx/fragment/app/Fragment;->getContext()Landroid/content/Context;
+
+    move-result-object v4
+
+    if-eqz v4, :cond_3
+
+    invoke-virtual {v4}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
+
+    move-result-object v4
+
+    const-string p1, "rezoss_pd_main_enabled"
+
+    invoke-static {v4, p1, v3}, Landroid/provider/Settings$System;->putInt(Landroid/content/ContentResolver;Ljava/lang/String;I)Z
+
+    const-string p1, "pd_main_enabled"
+
+    invoke-static {v4, p1, v3}, Landroid/provider/Settings$System;->putInt(Landroid/content/ContentResolver;Ljava/lang/String;I)Z
+
+    :cond_3
 
     const-string p1, "com.android.settings"
 
-    invoke-static {p1, p0}, Lcom/samsung/android/settings/bpd/utils/PdUtils;->setPdMainEnabled(Ljava/lang/String;Z)V
+    invoke-static {p1, v3}, Lcom/samsung/android/settings/bpd/utils/PdUtils;->setPdMainEnabled(Ljava/lang/String;Z)V
 
     return v2
 
