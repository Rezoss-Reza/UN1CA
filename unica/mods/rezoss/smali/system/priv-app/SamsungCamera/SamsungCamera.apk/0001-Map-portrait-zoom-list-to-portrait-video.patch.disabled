From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@unica.local>
Date: Fri, 24 Jul 2026 00:00:00 +0000
Subject: [PATCH] Map Portrait zoom list to Portrait Video slot on S23U

Return the working S23U portrait-video zoom-list index for ZoomType.PORTRAIT
so every portrait zoom metadata lookup uses slot 5 instead of the stock portrait
slot 7, which reports 1.0x..1.0x and can steer Portrait Photo into an invalid
HAL path.
---
 .../com/sec/android/app/camera/engine/core/CapabilityImpl.smali     | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/smali_classes4/com/sec/android/app/camera/engine/core/CapabilityImpl.smali b/smali_classes4/com/sec/android/app/camera/engine/core/CapabilityImpl.smali
index 1111111..2222222 100644
--- a/smali_classes4/com/sec/android/app/camera/engine/core/CapabilityImpl.smali
+++ b/smali_classes4/com/sec/android/app/camera/engine/core/CapabilityImpl.smali
@@ -931,6 +931,15 @@
 .method private getZoomListIndex(Lcom/sec/android/app/camera/interfaces/ZoomType;)I
     .locals 0
 
+    sget-object p0, Lcom/sec/android/app/camera/interfaces/ZoomType;->PORTRAIT:Lcom/sec/android/app/camera/interfaces/ZoomType;
+
+    if-ne p1, p0, :cond_unica_portrait_zoom_index_default
+
+    const/4 p0, 0x5
+
+    return p0
+
+    :cond_unica_portrait_zoom_index_default
     sget-object p0, Lcom/sec/android/app/camera/engine/core/CapabilityImpl$1;->$SwitchMap$com$sec$android$app$camera$interfaces$ZoomType:[I
 
     invoke-virtual {p1}, Ljava/lang/Enum;->ordinal()I
