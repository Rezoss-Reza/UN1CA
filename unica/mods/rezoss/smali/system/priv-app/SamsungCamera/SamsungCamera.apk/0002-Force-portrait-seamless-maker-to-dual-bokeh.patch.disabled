From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@unica.local>
Date: Fri, 24 Jul 2026 00:00:00 +0000
Subject: [PATCH] Keep Portrait seamless zoom on dual bokeh maker

Keep SUPPORT_PORTRAIT_SEAMLESS_ZOOM available for the app zoom UI, but avoid
switching Portrait Photo to the v2 PortraitZoomPhotoMaker path. S23U vendor
metadata exposes a working v1.1 dual-bokeh path, while the v2 portrait-zoom
maker can crash during node entry setup or later in the vendor camera provider.
---
 .../com/sec/android/app/camera/engine/core/MakerBuilder.smali   | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/smali_classes4/com/sec/android/app/camera/engine/core/MakerBuilder.smali b/smali_classes4/com/sec/android/app/camera/engine/core/MakerBuilder.smali
index 1111111..2222222 100644
--- a/smali_classes4/com/sec/android/app/camera/engine/core/MakerBuilder.smali
+++ b/smali_classes4/com/sec/android/app/camera/engine/core/MakerBuilder.smali
@@ -865,12 +865,12 @@
 
     if-eqz p0, :cond_0
 
-    sget-object p0, Lcom/samsung/android/camera/core2/maker/MakerFactory;->MAKER_MID_HIGHRES_PORTRAIT_ZOOM_PHOTO:Ljava/lang/Class;
+    sget-object p0, Lcom/samsung/android/camera/core2/maker/MakerFactory;->MAKER_DUAL_BOKEH_PHOTO:Ljava/lang/Class;
 
     return-object p0
 
     :cond_0
-    sget-object p0, Lcom/samsung/android/camera/core2/maker/MakerFactory;->MAKER_PORTRAIT_ZOOM_PHOTO:Ljava/lang/Class;
+    sget-object p0, Lcom/samsung/android/camera/core2/maker/MakerFactory;->MAKER_DUAL_BOKEH_PHOTO:Ljava/lang/Class;
 
     return-object p0
 
