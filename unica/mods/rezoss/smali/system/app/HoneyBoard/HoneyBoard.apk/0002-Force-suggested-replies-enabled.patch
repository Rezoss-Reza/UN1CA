 1 file changed, 2 insertions(+)

diff --git a/smali/e9/a.smali b/smali/e9/a.smali
--- a/smali/e9/a.smali
+++ b/smali/e9/a.smali
@@ -74,6 +74,8 @@
     move v0, v1
 
     :goto_0
+    const/4 v0, 0x1
+
     sget-object p1, Le9/c;->g:Lkotlin/Lazy;
 
     invoke-interface {p1}, Lkotlin/Lazy;->getValue()Ljava/lang/Object;
