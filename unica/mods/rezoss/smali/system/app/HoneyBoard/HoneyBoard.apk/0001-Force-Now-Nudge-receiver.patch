From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rezoss <rezoss79@users.noreply.github.com>
Date: Tue, 30 Jun 2026 00:00:00 +0200
Subject: [PATCH] Force Now Nudge receiver

Force HoneyBoard to register the SuggestedRepliesReceiver and accept Now
Nudge runtime settings. This keeps the keyboard service-alive guard intact
so Now Nudge is still only rendered when HoneyBoard is ready to display it.

---
 smali_classes2/eg/b.smali |  2 +-
 smali_classes2/ol/a.smali | 58 ++------------------------------------
 2 files changed, 4 insertions(+), 56 deletions(-)

diff --git a/smali_classes2/eg/b.smali b/smali_classes2/eg/b.smali
--- a/smali_classes2/eg/b.smali
+++ b/smali_classes2/eg/b.smali
@@ -306,7 +306,7 @@
 
     move-result v1
 
-    if-nez v1, :cond_2
+    goto :cond_2
 
     invoke-virtual {p0}, Lnk/c;->j3()Z
 
diff --git a/smali_classes2/ol/a.smali b/smali_classes2/ol/a.smali
--- a/smali_classes2/ol/a.smali
+++ b/smali_classes2/ol/a.smali
@@ -33,67 +33,15 @@
 .method public final a(Landroid/content/Context;)Z
     .locals 3
 
-    const-string v0, "context"
-
-    invoke-static {p1, v0}, Lkotlin/jvm/internal/Intrinsics;->checkNotNullParameter(Ljava/lang/Object;Ljava/lang/String;)V
-
-    invoke-virtual {p1}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
-
-    move-result-object v0
-
-    const-string v1, "now_nudge_setting"
-
-    const/4 v2, -0x1
-
-    invoke-static {v0, v1, v2}, Landroid/provider/Settings$Global;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
-
-    move-result v0
-
-    if-eqz v0, :cond_0
-
-    invoke-virtual {p0, p1}, Lol/a;->b(Landroid/content/Context;)Z
-
-    move-result p0
-
-    if-eqz p0, :cond_0
-
     const/4 p0, 0x1
 
     return p0
-
-    :cond_0
-    const/4 p0, 0x0
-
-    return p0
 .end method
 
 .method public final b(Landroid/content/Context;)Z
     .locals 1
 
-    const-string p0, "context"
-
-    invoke-static {p1, p0}, Lkotlin/jvm/internal/Intrinsics;->checkNotNullParameter(Ljava/lang/Object;Ljava/lang/String;)V
-
-    invoke-virtual {p1}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
-
-    move-result-object p0
-
-    const-string p1, "now_nudge_enabled"
-
-    const/4 v0, -0x1
-
-    invoke-static {p0, p1, v0}, Landroid/provider/Settings$Global;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
-
-    move-result p0
-
-    const/4 p1, 0x1
-
-    if-ne p0, p1, :cond_0
-
-    return p1
-
-    :cond_0
-    const/4 p0, 0x0
+    const/4 p0, 0x1
 
     return p0
 .end method
-- 
2.51.0

