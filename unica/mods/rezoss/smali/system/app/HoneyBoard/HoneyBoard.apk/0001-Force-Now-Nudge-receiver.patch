From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rezoss <rezoss79@users.noreply.github.com>
Date: Tue, 30 Jun 2026 00:00:00 +0200
Subject: [PATCH] Force Now Nudge receiver

Force HoneyBoard to register the SuggestedRepliesReceiver and accept Now
Nudge runtime settings. This keeps the keyboard service-alive guard intact
so Now Nudge is still only rendered when HoneyBoard is ready to display it.

---
 smali/T6/b.smali                                                   | 2 +-
 smali/com/samsung/android/honeyboard/base/suggestedreplies/receiver/SuggestedRepliesReceiver.smali | 2 +-
 smali_classes2/Bq/m.smali                                          | 58 +-------------------------------
 3 files changed, 4 insertions(+), 60 deletions(-)

diff --git a/smali/T6/b.smali b/smali/T6/b.smali
--- a/smali/T6/b.smali
+++ b/smali/T6/b.smali
@@ -313 +313 @@
-    if-nez p0, :cond_2
+    goto :cond_2
diff --git a/smali/com/samsung/android/honeyboard/base/suggestedreplies/receiver/SuggestedRepliesReceiver.smali b/smali/com/samsung/android/honeyboard/base/suggestedreplies/receiver/SuggestedRepliesReceiver.smali
--- a/smali/com/samsung/android/honeyboard/base/suggestedreplies/receiver/SuggestedRepliesReceiver.smali
+++ b/smali/com/samsung/android/honeyboard/base/suggestedreplies/receiver/SuggestedRepliesReceiver.smali
@@ -813 +813 @@
-    if-ne v0, v14, :cond_1b
+    nop
diff --git a/smali_classes2/Bq/m.smali b/smali_classes2/Bq/m.smali
--- a/smali_classes2/Bq/m.smali
+++ b/smali_classes2/Bq/m.smali
@@ -403 +403 @@
-    iget-object p0, p0, LBq/m;->d:Lkotlin/Lazy;
+    const/4 p0, 0x1
@@ -405,56 +405 @@
-    invoke-interface {p0}, Lkotlin/Lazy;->getValue()Ljava/lang/Object;
-
-    move-result-object p0
-
-    check-cast p0, Landroid/content/Context;
-
-    const-string v0, "context"
-
-    invoke-static {p0, v0}, Lkotlin/jvm/internal/Intrinsics;->checkNotNullParameter(Ljava/lang/Object;Ljava/lang/String;)V
-
-    invoke-virtual {p0}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
-
-    move-result-object v1
-
-    const-string v2, "now_nudge_setting"
-
-    const/4 v3, -0x1
-
-    invoke-static {v1, v2, v3}, Landroid/provider/Settings$Global;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
-
-    move-result v1
-
-    const/4 v2, 0x0
-
-    if-eqz v1, :cond_1
-
-    invoke-static {p0, v0}, Lkotlin/jvm/internal/Intrinsics;->checkNotNullParameter(Ljava/lang/Object;Ljava/lang/String;)V
-
-    invoke-virtual {p0}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
-
-    move-result-object p0
-
-    const-string v0, "now_nudge_enabled"
-
-    invoke-static {p0, v0, v3}, Landroid/provider/Settings$Global;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
-
-    move-result p0
-
-    const/4 v0, 0x1
-
-    if-ne p0, v0, :cond_0
-
-    move p0, v0
-
-    goto :goto_0
-
-    :cond_0
-    move p0, v2
-
-    :goto_0
-    if-eqz p0, :cond_1
-
-    move v2, v0
-
-    :cond_1
-    return v2
+    return p0
-- 
