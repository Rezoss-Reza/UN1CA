From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <noreply@unica>
Subject: [PATCH] Allow app downgrade

Android 17: anchor the toggle in verifyReplacingVersionCode and retain
registers and monitor exception coverage.
---
diff --git a/smali_classes2/com/android/server/pm/PackageManagerService.smali b/smali_classes2/com/android/server/pm/PackageManagerService.smali
--- a/smali_classes2/com/android/server/pm/PackageManagerService.smali
+++ b/smali_classes2/com/android/server/pm/PackageManagerService.smali
@@ -21714,24 +21714,42 @@
     invoke-static {p0}, Lcom/android/server/wm/Task$$ExternalSyntheticBUOutline0;->m(Ljava/lang/String;)V

     return-void

     :cond_2
     const-string/jumbo p0, "holdLock requires a debuggable build"

     invoke-static {p0}, Lcom/android/server/wm/Task$$ExternalSyntheticBUOutline0;->m(Ljava/lang/String;)V

     return-void
 .end method

+.method private static isUnicaDowngradeAllowed(Landroid/content/Context;)Z
+    .locals 3
+
+    invoke-virtual {p0}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
+
+    move-result-object v0
+
+    const-string v1, "unica_allow_downgrade"
+
+    const/4 v2, 0x0
+
+    invoke-static {v0, v1, v2}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
+
+    move-result v0
+
+    return v0
+.end method
+
 .method public final verifyReplacingVersionCode(Landroid/content/pm/PackageInfoLite;JI)Landroid/util/Pair;
     .locals 20

     move-object/from16 v5, p1

     move-wide/from16 v0, p2

     move-object/from16 v2, p0

     move/from16 v3, p4

     iget-object v2, v2, Lcom/android/server/pm/PackageManagerService;->mInstallPackageHelper:Lcom/android/server/pm/InstallPackageHelper;
@@ -22229,24 +22247,34 @@

     move-result v0

     if-nez v0, :cond_e

     invoke-interface {v14}, Lcom/android/server/pm/pkg/AndroidPackage;->isDebuggable()Z

     move-result v0

     invoke-static {v3, v0}, Lcom/android/server/pm/PackageManagerServiceUtils;->isDowngradePermitted(IZ)Z

     move-result v0
+
+    if-nez v0, :unica_downgrade_checked
+
+    iget-object v0, v2, Lcom/android/server/pm/InstallPackageHelper;->mContext:Landroid/content/Context;
+
+    invoke-static {v0}, Lcom/android/server/pm/PackageManagerService;->isUnicaDowngradeAllowed(Landroid/content/Context;)Z
+
+    move-result v0
+
+    :unica_downgrade_checked
     :try_end_8
     .catchall {:try_start_8 .. :try_end_8} :catchall_1

     if-nez v0, :cond_c

     :try_start_9
     invoke-interface {v14}, Lcom/android/server/pm/pkg/AndroidPackage;->getLongVersionCode()J

     move-result-wide v0

     invoke-interface {v14}, Lcom/android/server/pm/pkg/AndroidPackage;->getBaseRevisionCode()I

--
