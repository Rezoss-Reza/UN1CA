From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA <unica@local>
Date: Fri, 28 Aug 2026 14:10:04 +0200
Subject: [PATCH] Add spacing to status bar network speed

---
 res/layout/samsung_status_bar_network_speed_view.xml                    | 2 +-
 res/values/dimens.xml                                                   | 2 +-
 smali_classes3/com/android/systemui/statusbar/policy/NetspeedView.smali | 6 ++++++
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/res/layout/samsung_status_bar_network_speed_view.xml b/res/layout/samsung_status_bar_network_speed_view.xml
index 3287a85aa..4dd364321 100644
--- a/res/layout/samsung_status_bar_network_speed_view.xml
+++ b/res/layout/samsung_status_bar_network_speed_view.xml
@@ -1,5 +1,5 @@
 <?xml version="1.0" encoding="utf-8"?>
-<com.android.systemui.statusbar.policy.NetspeedView android:gravity="end|center" android:id="@id/networkSpeed" android:layout_width="wrap_content" android:layout_height="match_parent"
+<com.android.systemui.statusbar.policy.NetspeedView android:gravity="end|center" android:id="@id/networkSpeed" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingEnd="@dimen/network_speed_padding_end"
   xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
     <com.android.systemui.statusbar.phone.SwitchableDoubleShadowTextView android:textSize="@dimen/status_bar_netspeed_size" android:textStyle="bold" android:textColor="@color/status_bar_clock_color" android:gravity="center" android:id="@id/network_speed_contentview" android:clipChildren="false" android:clipToPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:lineSpacingExtra="@dimen/netspeed_line_space_extra" android:importantForAccessibility="no" android:fontFamily="sans-serif" app:ambientShadowAlpha="0.0" app:ambientShadowBlur="@dimen/shadow_radius" app:ambientShadowOffsetX="@dimen/shadow_difference" app:ambientShadowOffsetY="@dimen/shadow_difference" app:keyShadowAlpha="0.2" app:keyShadowBlur="@dimen/shadow_radius" app:keyShadowOffsetX="@dimen/shadow_difference" app:keyShadowOffsetY="@dimen/shadow_difference" />
 </com.android.systemui.statusbar.policy.NetspeedView>
diff --git a/res/values/dimens.xml b/res/values/dimens.xml
index 245cfd6b0..25c67a444 100644
--- a/res/values/dimens.xml
+++ b/res/values/dimens.xml
@@ -3158,7 +3158,7 @@
     <dimen name="navigation_side_padding">36.0dp</dimen>
     <dimen name="negative_overlay_action_container_minimum_edge_spacing">-12.0dp</dimen>
     <dimen name="netspeed_line_space_extra">-2.0dp</dimen>
-    <dimen name="network_speed_padding_end">3.0dp</dimen>
+    <dimen name="network_speed_padding_end">8.0dp</dimen>
     <dimen name="new_qs_header_non_clickable_element_height">24.0sp</dimen>
     <dimen name="no_more_bubble_text_size">17.0sp</dimen>
     <dimen name="no_notification_shadow_radius">5.0dp</dimen>
diff --git a/smali_classes3/com/android/systemui/statusbar/policy/NetspeedView.smali b/smali_classes3/com/android/systemui/statusbar/policy/NetspeedView.smali
index 5f5e6ee18..7c9afe07f 100644
--- a/smali_classes3/com/android/systemui/statusbar/policy/NetspeedView.smali
+++ b/smali_classes3/com/android/systemui/statusbar/policy/NetspeedView.smali
@@ -345,5 +345,11 @@
     :cond_2
+    invoke-virtual {p0}, Landroid/widget/LinearLayout;->getPaddingEnd()I
+
+    move-result v1
+
+    add-int/2addr p1, v1
+
     if-eq v0, p1, :cond_3
 
     invoke-static {p2}, Landroid/view/View$MeasureSpec;->getSize(I)I
 
-- 
2.51.1
